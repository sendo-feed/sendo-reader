{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!packages/core/src/api/schema.gen.ts",
      "!packages/core/src/api/openapi.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "svelte": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "error",
        "useExportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "nursery": {
        "noSvelteAtHtmlTags": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/**", "apps/web/src/**", "apps/web/worker/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["svelte", "svelte/**"],
                    "message": "packages/core は UI のフレームワークに依存させない（docs/decisions/local-first.md）。"
                  },
                  {
                    "group": ["@sendo-reader/web", "@sendo-reader/web/**", "**/apps/**"],
                    "message": "packages/core から apps/ を import しない（docs/decisions/local-first.md）。"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
