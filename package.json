{
  "name": "sendo-reader",
  "version": "0.0.0",
  "private": true,
  "description": "The official reader for Sendo. Local-first PWA built on Svelte 5, synced with the Sendo server.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @sendo-reader/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "size": "node scripts/check-size.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "6.0.3"
  }
}
