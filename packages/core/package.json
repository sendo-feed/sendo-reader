{
  "name": "@sendo-reader/core",
  "version": "0.0.0",
  "private": true,
  "description": "Sync engine and local database for sendo-reader. Independent of any UI framework.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web/client.ts",
    "./web/worker": "./src/web/worker.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:fetch": "node scripts/fetch-openapi.mjs",
    "api:generate": "openapi-typescript src/api/openapi.json --output src/api/schema.gen.ts"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.5",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "openapi-fetch": "0.17.0"
  },
  "sideEffects": false
}
