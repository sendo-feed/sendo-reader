# 依存
node_modules/

# ビルドと実行の生成物
dist/
.wrangler/
coverage/

# wrangler types の生成物（pnpm install のときに生成する）
worker-configuration.d.ts

# 手元の秘密情報
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# ログ
*.log

# OS とエディタ
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code の個人設定
.claude/settings.local.json

# 手元の作業用（試しに動かす、メモ、下書きなど。コミットしない）
tmp/
.tmp/
temp/
scratch/
.scratch/
work/
.work/

# Claude Code が作る作業用の worktree
.claude/worktrees/

# 画面を通したテスト（Playwright）と Lighthouse CI の出力
test-results/
playwright-report/
.lighthouseci/
