{
  "name": "@sendo-reader/web",
  "version": "0.0.0",
  "private": true,
  "description": "sendo-reader for the web (PWA). Svelte 5 + Vite, served by a Node server in a container.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm run build:server",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist-server/server.mjs",
    "start:server": "node --enable-source-maps dist-server/server.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p server && tsc --noEmit -p test && tsc --noEmit -p test/server && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@sendo-reader/core": "workspace:*",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.6",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "hono": "4.13.16",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
