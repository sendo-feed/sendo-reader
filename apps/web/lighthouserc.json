{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec vite preview --port 4174 --strictPort",
      "startServerReadyPattern": "Local",
      "url": ["http://localhost:4174/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
