{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sendo-reader",
  "main": "worker/index.ts",
  // 日付を上げるときは、Workers の互換性の変更点を確かめてから上げる
  "compatibility_date": "2026-10-29",
  // nodejs_compat は付けない。Web 標準の API だけで書く
  "observability": {
    "enabled": true
  },

  // 画面（vite build の出力）。SPA なので、ないパスには index.html を返す。
  // /api だけは先に Worker に回し、sendo に中継する
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // sendo（Worker 名 sendo）に中継する。同じアカウントにデプロイしておく
  "services": [{ "binding": "SENDO", "service": "sendo" }]
}
