{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    // <script lang="ts"> のない .svelte も型を調べる（svelte-check が JS として扱うため）
    "allowJs": true,
    "checkJs": true,
    // vite.config.ts は Vite が Node でそのまま読むので、import に拡張子を付ける
    "allowImportingTsExtensions": true
  },
  // worker/ と test/ はそれぞれの tsconfig で調べる（実行する場所が違うため）
  "include": ["src", "vite.config.ts", "vitest.config.ts", "security-headers.ts"]
}
